# Keep real configuration outside the repository.
# Backend must run as a non-privileged PostgreSQL role with CONNECT, USAGE, and DML only.
HOST=127.0.0.1
PORT=3087
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=zastavkobrani_staging
PGUSER=zastavkobrani_app
PGPOOL_MAX=3
PGCONNECT_TIMEOUT_MS=2000
